<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KVSynology" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Branded launch splash: logo-blue background + white NAS mark -->
    <style name="Theme.KVSynology.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/synology_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_glyph</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.KVSynology</item>
    </style>
</resources>
